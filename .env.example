# Required public application origin (set separately for Development/Preview/Production)
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Required public Supabase connection settings (safe for browser use; RLS is mandatory)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Do not place secret or service-role keys in this file or in NEXT_PUBLIC_ variables.
# Optional SERVER-ONLY language provider. Leave blank until explicitly approved.
OPENAI_API_KEY=
